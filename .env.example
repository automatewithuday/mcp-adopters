# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=            # classic token, scope read:user is enough
TYPESAFE_API_KEY=

# Enrichment provider (src/lib/providers). Default: deepline
ENRICH_PROVIDER=deepline
DEEPLINE_API_KEY=        # only for cloud deploys; local runs use `deepline auth register`

# Optional: Trigger.dev
TRIGGER_SECRET_KEY=
